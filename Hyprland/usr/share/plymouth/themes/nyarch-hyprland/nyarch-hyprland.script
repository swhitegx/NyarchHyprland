# Nyarch Hyprland Plymouth theme script (placeholder)
# This will be filled in with actual animations

MessagePause = 100.0

Window.SetBackgroundTopColor (0.15, 0.16, 0.18)
Window.SetBackgroundBottomColor (0.10, 0.11, 0.13)

logo = Image("nyarch-hyprland-logo.png");
sprite = Sprite();
sprite.SetImage(logo);
sprite.SetX(Window.GetWidth() / 2 - logo.GetWidth() / 2);
sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2);

fun refresh_callback ()
{
}

Plymouth.SetRefreshFunction (refresh_callback);

{
    "layer": "top",
    "position": "top",
    "height": 30,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "bluetooth", "tray", "custom/power"],
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },
    "clock": {
        "format": "{:%H:%M  %m/%d}",
        "tooltip-format": "{:%Y-%m-%d | %H:%M}"
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "🌐 {ipaddr}",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-icons": ["🔇", "🔈", "🔉", "🔊"],
        "on-click": "pavucontrol"
    },
    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "format-disconnected": "",
        "on-click": "blueman-manager"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 5
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "wofi --show drun",
        "tooltip": "Application Launcher"
    }
}

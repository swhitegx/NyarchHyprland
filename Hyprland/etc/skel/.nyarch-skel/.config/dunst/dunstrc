[global]
    monitor = 0
    follow_mouse = 1
    geometry = "300x50-30+50"
    padding = 16
    horizontal_padding = 16
    frame_width = 2
    frame_color = "#90beff"
    separator_color = "#404050"
    sort = yes
    font = "JetBrains Mono 11"
    line_height = 0
    markup = yes
    format = "<b>%s</b>\\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicates_count = 2
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/wofi -dmenu

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    context = ctrl+shift+period

[urgency_low]
    background = "#262830"
    foreground = "#e0e0e8"
    timeout = 5

[urgency_normal]
    background = "#262830"
    foreground = "#e0e0e8"
    timeout = 8

[urgency_critical]
    background = "#3a1a1a"
    foreground = "#f28b82"
    frame_color = "#f28b82"
    timeout = 0

[global]
    monitor = 0
    follow_mouse = 1
    geometry = "300x50-30+50"
    padding = 16
    frame_width = 2
    frame_color = "#90beff"
    font = "JetBrains Mono 11"
    markup = yes
    format = "<b>%s</b>\n%b"
    word_wrap = yes
    stack_duplicates = true

[urgency_low]
    background = "#262830"
    foreground = "#e0e0e8"
    timeout = 5

[urgency_normal]
    background = "#262830"
    foreground = "#e0e0e8"
    timeout = 8

[urgency_critical]
    background = "#3a1a1a"
    foreground = "#f28b82"
    frame_color = "#f28b82"

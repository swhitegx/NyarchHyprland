# remove from airootfs!
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = *

[Action]
Description = Remove custom hooks from airootfs on first boot...
When = PostTransaction
Depends = bash
Exec = /bin/sh -c "if grep -q airootfs /proc/1/cmdline 2>/dev/null; then exit 0; fi; rm -f /etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook; rm -f /etc/pacman.d/hooks/40-locale-gen.hook; rm -f /etc/pacman.d/hooks/uncomment-mirrors.hook"
